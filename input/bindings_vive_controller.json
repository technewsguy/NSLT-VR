{
  "controller_type": "vive_controller",
  "description": "NSLT-VR default for Vive wands: trackpad = stick, grip = lower button, menu = upper button",
  "name": "NSLT-VR default",
  "bindings": {
    "/actions/nslt": {
      "sources": [
        { "path": "/user/hand/left/input/trackpad", "mode": "trackpad",
          "inputs": { "position": { "output": "/actions/nslt/in/stick_l" }, "click": { "output": "/actions/nslt/in/stickclick_l" } } },
        { "path": "/user/hand/right/input/trackpad", "mode": "trackpad",
          "inputs": { "position": { "output": "/actions/nslt/in/stick_r" }, "click": { "output": "/actions/nslt/in/stickclick_r" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "trigger",
          "inputs": { "pull": { "output": "/actions/nslt/in/trigger_l" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger",
          "inputs": { "pull": { "output": "/actions/nslt/in/trigger_r" } } },
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/nslt/in/a_l" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/nslt/in/a_r" } } },
        { "path": "/user/hand/left/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/nslt/in/b_l" } } },
        { "path": "/user/hand/right/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/nslt/in/b_r" } } }
      ],
      "haptics": [
        { "output": "/actions/nslt/out/haptic_l", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/nslt/out/haptic_r", "path": "/user/hand/right/output/haptic" }
      ]
    }
  }
}
